#
#   GNUmakefile.preamble
#
#   Project specific makefile variables, and additional
#
#   Do not put any GNUmakefile rules in this file, instead they should
#   be put into GNUmakefile.postamble.
#

#
# Flags dealing with compiling and linking
#

# Additional flags to pass to the preprocessor
ADDITIONAL_CPPFLAGS =  \
	-DGNUSTEP_TARGET_DIR=\"$(GNUSTEP_TARGET_DIR)\" \
	-DGNUSTEP_TARGET_CPU=\"$(GNUSTEP_TARGET_CPU)\" \
	-DGNUSTEP_TARGET_OS=\"$(GNUSTEP_TARGET_OS)\" \
	-DLIBRARY_COMBO=\"$(LIBRARY_COMBO)\" \
	-DGNUSTEP_BASE_HAVE_LIBXML=$(GNUSTEP_BASE_HAVE_LIBXML) \

ifneq ($(BACKEND_BUNDLE),)
ADDITIONAL_CPPFLAGS += -DBACKEND_BUNDLE=1
endif

# Additional flags to pass to the Objective-C compiler
ADDITIONAL_OBJCFLAGS = -Wall

# Additional flags to pass to the C compiler
ADDITIONAL_CFLAGS += $(MOVIE_BASE_CFLAGS) $(SOUND_CFLAGS)

# Additional include directories the compiler should search
ADDITIONAL_INCLUDE_DIRS += -I../Headers/Additions -I../Headers \
   -I./$(GNUSTEP_TARGET_DIR)

# Additional LDFLAGS to pass to the linker
# ADDITIONAL_LDFLAGS = 

# Additional library directories the linker should search
ADDITIONAL_LIB_DIRS +=

#
# Flags dealing with installing and uninstalling
#

# Additional directories to be created during installation
ADDITIONAL_INSTALL_DIRS = $(GNUSTEP_HEADERS)/AppKit $(GNUSTEP_HEADERS)/Cocoa

# What are the libraries this library depends upon. This is needed for some
# systems where building a shared library requires to pass to the linker
# all the libraries the target library depends upon.
# GNUstep make expects the target-prefixed form for library targets.

libgnustep-gui_LIBRARIES_DEPEND_UPON = -l$(FOUNDATION_LIBRARY_NAME) $(ADDITIONAL_DEPENDS) \
					  $(MOVIE_BASE_LIBS) $(SOUND_LIBS) \
					  $(OBJC_LIBS)

# Keep the generic variable in sync for compatibility with older make setups.
LIBRARIES_DEPEND_UPON = $(libgnustep-gui_LIBRARIES_DEPEND_UPON)

# Select the provider when compiling AppKit. No theme bundles are loaded.
GNUSTEP_BUILTIN_THEME ?= GNUstep
ADDITIONAL_INCLUDE_DIRS += -I.
ifeq ($(GNUSTEP_BUILTIN_THEME),GNUstep)
GS_BUILTIN_CLASS = GSGNUstepTheme
GS_STATIC_GTK4 = 0
else ifeq ($(GNUSTEP_BUILTIN_THEME),GTK4Native)
GTK4_NATIVE_DIR ?= $(abspath ../../../native/GTK4Native)
libgnustep-gui_OBJC_FILES += $(GTK4_NATIVE_DIR)/GTK4NativeTheme.m $(GTK4_NATIVE_DIR)/GTK4NativeMenu.m $(GTK4_NATIVE_DIR)/GTK4NativeFilePanel.m $(GTK4_NATIVE_DIR)/GTK4NativeWindow.m $(GTK4_NATIVE_DIR)/GTK4NativeView.m $(GTK4_NATIVE_DIR)/GTK4NativeTable.m
libgnustep-gui_C_FILES += $(GTK4_NATIVE_DIR)/GTK4Renderer.c
GS_BUILTIN_CLASS = GTK4NativeTheme
GS_STATIC_GTK4 = 1
ADDITIONAL_OBJCFLAGS += $(shell pkg-config --cflags gtk4)
ADDITIONAL_CFLAGS += $(shell pkg-config --cflags gtk4)
libgnustep-gui_LIBRARIES_DEPEND_UPON += $(shell pkg-config --libs gtk4-x11 xext)
else
$(error Unsupported GNUSTEP_BUILTIN_THEME: $(GNUSTEP_BUILTIN_THEME))
endif

# Refresh the compiler dependency only when the selected provider changes.
GS_THEME_SELECTION := $(shell printf '\043define GS_BUILTIN_THEME_CLASS $(GS_BUILTIN_CLASS)\n\043define GS_STATIC_GTK4 $(GS_STATIC_GTK4)\n' > GSBuiltinThemeSelection.h.tmp; cmp -s GSBuiltinThemeSelection.h.tmp GSBuiltinThemeSelection.h || cp GSBuiltinThemeSelection.h.tmp GSBuiltinThemeSelection.h; rm -f GSBuiltinThemeSelection.h.tmp)
